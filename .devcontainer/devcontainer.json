{
    "name": "NeuroFM",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },

    // GPU if available, CPU fallback — no hard requirement
    "hostRequirements": {
        "gpu": "optional"
    },

    // Pass GPUs through to the container when available
    "runArgs": [
        "--gpus", "all"
    ],

    // Mount the repo into the container
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "workspaceFolder": "/workspace",

    // Environment variables
    "containerEnv": {
        // Suppress TF info/warning logs in the terminal by default.
        // Set to 0 for full TF verbosity if debugging GPU issues.
        "TF_CPP_MIN_LOG_LEVEL": "2"
    },

    // Re-install the package in editable mode after the container is created
    // so local edits to neurofm/ are immediately reflected without reinstalling
    "postCreateCommand": "pip install -e .",

    // VS Code extensions
    "customizations": {
        "vscode": {
            "extensions": [
                // Python
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.black-formatter",

                // Notebooks
                "ms-toolsai.jupyter",
                "ms-toolsai.jupyter-renderers",

                // Nicer development experience
                "eamodio.gitlens",
                "gruntfuggly.todo-tree",
                "streetsidesoftware.code-spell-checker"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "editor.formatOnSave": true,
                "python.formatting.provider": "black",
                "[python]": {
                    "editor.defaultFormatter": "ms-python.python"
                },
                "editor.rulers": [88],
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    }
}